# --- Gemini API (TTS, text enhancement, scene planning) ---
GEMINI_API_KEY=

# --- Telegram Bot API ---
# Create a bot with @BotFather on Telegram, it gives you this token.
TELEGRAM_BOT_TOKEN=
# Your own numeric Telegram user id (message @userinfobot to find it).
# Only this user (or a comma-separated list) may use the bot.
TELEGRAM_ALLOWED_USER_IDS=
# Chat id that receives error/alert notifications (can be the same as above).
TELEGRAM_ADMIN_CHAT_ID=

# --- Cloudflare Workers AI (free scene image generation) ---
# dash.cloudflare.com -> Workers & Pages -> Overview (right sidebar).
CLOUDFLARE_ACCOUNT_ID=
# My Profile -> API Tokens -> Create Token (Workers AI read/edit).
CLOUDFLARE_API_TOKEN=

# --- Misc ---
DATA_DIR=./data/jobs
STATE_DIR=./state
