# --- Gemini API (TTS, text enhancement, scene planning) ---
GEMINI_API_KEY=

# --- Telegram Bot API ---
# Create a bot with @BotFather on Telegram, it gives you this token.
TELEGRAM_BOT_TOKEN=
# Your own numeric Telegram user id (message @userinfobot to find it).
# Only this user (or a comma-separated list) may use the bot.
TELEGRAM_ALLOWED_USER_IDS=
# Chat id that receives error/alert notifications (can be the same as above).
TELEGRAM_ADMIN_CHAT_ID=

# --- Google Flow (Veo) browser automation ---
# Base64 string printed by `npm run login:flow`. On GitHub Actions this is a
# repository *secret*; for local testing put it directly in this .env file.
FLOW_STORAGE_STATE=
# The Flow project URL to reuse for every job.
FLOW_PROJECT_URL=

# --- Misc ---
DATA_DIR=./data/jobs
STATE_DIR=./state
